[Unit]
Description=Read-only daily NIFTY strategy observations
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sablestone
Group=dhan-dashboard
SupplementaryGroups=sablestone
WorkingDirectory=/opt/sablestone-dhan-dashboard/current
ExecStart=/opt/sablestone-dhan-dashboard/current/.venv/bin/python -m dhan_cas_bot.daily_monitor
EnvironmentFile=/etc/sablestone-dhan/secrets.env
Environment=DHAN_BROKER_READ_ONLY=1
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=15
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sablestone-dhan-dashboard
InaccessiblePaths=-/var/lib/sablestone-dhan/ledger.sqlite3 -/var/lib/sablestone-dhan/ledger.sqlite3-wal -/var/lib/sablestone-dhan/ledger.sqlite3-shm
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
