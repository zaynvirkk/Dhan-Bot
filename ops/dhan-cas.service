[Unit]
Description=SableStone Dhan CAS AUTO_LIVE service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=sablestone
WorkingDirectory=/opt/sablestone-dhan-cas-bot
ExecStart=/opt/sablestone-dhan-cas-bot/.venv/bin/dhan-cas run --mode AUTO_LIVE --config /etc/sablestone-dhan/production.toml
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sablestone-dhan
EnvironmentFile=/etc/sablestone-dhan/secrets.env
Environment=DHAN_BROKER_READ_ONLY=1
Environment=PYTHONUNBUFFERED=1
UMask=0077

[Install]
WantedBy=multi-user.target
