[Unit]
Description=HTTPS for the private Dhan dashboard
After=network-online.target dhan-dashboard.service
Wants=network-online.target
Requires=dhan-dashboard.service

[Service]
User=caddy
Group=caddy
ExecStart=/usr/bin/caddy run --config /etc/sablestone-dhan-dashboard/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
Environment=XDG_DATA_HOME=/var/lib/caddy
Environment=XDG_CONFIG_HOME=/var/lib/caddy
StateDirectory=caddy
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caddy
InaccessiblePaths=/etc/sablestone-dhan /var/lib/sablestone-dhan /etc/sablestone-dhan-dashboard/auth.json /etc/sablestone-dhan-dashboard/login.txt
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
UMask=0077

[Install]
WantedBy=multi-user.target
